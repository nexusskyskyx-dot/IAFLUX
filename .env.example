# Optional server-side keys. Users can instead connect their own keys inside AIFLUX.
OPENROUTER_API_KEY=
XKIRO_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional GitHub App OAuth for repository context and user-confirmed Canvas publishing.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-domain.example/api/github
# Optional direct-install shortcut for the app, e.g. https://github.com/apps/aiflux/installations/new.
GITHUB_APP_INSTALL_URL=
# Generate a random secret with at least 32 characters (for example: openssl rand -hex 32).
GITHUB_SESSION_SECRET=

# Optional Tavily key for live web search. Without it, keyless search is
# available but shares rate limits; users can also enter their own key in Settings.
TAVILY_API_KEY=

# Optional: protect requests that use server-side keys on a publicly deployed instance.
AIFLUX_ACCESS_CODE=

# Optional: point to an Ollama server running on the SAME machine as AIFLUX.
# Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=

PORT=3000
