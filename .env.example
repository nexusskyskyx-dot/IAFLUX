# Optional server-side keys. Users can instead connect their own keys inside AIFLUX.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XKIRO_API_KEY=

# Live web search runs through x-web (one API over Tavily, Brave, Serper, Exa).
# XWEB_BASE overrides the default deployment URL; XWEB_KEY holds a key on the
# server so search works with nothing entered in Settings. Without either,
# visitors supply their own key in Settings.
XWEB_BASE=
XWEB_KEY=

# Optional: protect requests that use server-side keys on a publicly deployed instance.
AIFLUX_ACCESS_CODE=

# Optional: point to an Ollama server running on the SAME machine as AIFLUX.
# Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Optional: per-request budget in milliseconds before AIFLUX stops an answer and
# returns a readable message. Defaults to 120000 self-hosted and 55000 on Vercel
# (which ends a function at its maxDuration). Keep it below your platform limit.
# AIFLUX_REQUEST_TIMEOUT_MS=55000

PORT=3000
